{
  "name": "nasun-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter './apps/*' dev",
    "dev:network-explorer": "pnpm --filter @nasun/network-explorer dev",
    "dev:nasun-website": "pnpm --filter @nasun/nasun-website dev",
    "dev:gensol-website": "pnpm --filter @nasun/gensol-website dev",
    "dev:pado": "pnpm --filter @nasun/pado dev",
    "dev:pado:with-bot": "pnpm --filter @nasun/pado dev & (cd apps/pado/bots && pnpm lp-bot:all) & (cd apps/pado/bots && pnpm price-updater) & (cd apps/pado/bots && pnpm tpsl-keeper) & wait",
    "dev:gostop": "pnpm --filter @nasun/gostop dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:network-explorer": "pnpm --filter @nasun/network-explorer... build",
    "build:nasun-website": "pnpm --filter @nasun/nasun-website... build",
    "build:gensol-website": "pnpm --filter @nasun/gensol-website... build",
    "build:pado": "pnpm --filter @nasun/pado... build",
    "build:gostop": "pnpm --filter @nasun/gostop... build",
    "deploy:nasun-website:staging": "./scripts/deploy-nasun-website-staging.sh",
    "deploy:nasun-website:prod": "./scripts/deploy-nasun-website-production.sh",
    "deploy:gensol-website:staging": "./scripts/deploy-gensol-website-staging.sh",
    "deploy:network-explorer:staging": "./scripts/deploy-network-explorer-staging.sh",
    "deploy:network-explorer:prod": "./scripts/deploy-network-explorer-production.sh",
    "deploy:pado:staging": "./scripts/deploy-pado-staging.sh",
    "deploy:pado:prod": "./scripts/deploy-pado-production.sh",
    "deploy:pado:bots:staging": "./scripts/deploy-pado-bots.sh --staging",
    "deploy:pado:bots:prod": "./scripts/deploy-pado-bots.sh --production",
    "deploy:gostop:staging": "./scripts/deploy-gostop-staging.sh",
    "deploy:gostop:prod": "./scripts/deploy-gostop-production.sh",
    "deploy:gostop:bots:prod": "./scripts/deploy-gostop-bots.sh",
    "deploy:gostop-backend:prod": "./scripts/deploy-gostop-backend-production.sh",
    "deploy:nasun-chat-server:prod": "./scripts/deploy-nasun-chat-server-production.sh",
    "deploy:nasun-ai-runtime:prod": "./scripts/deploy-nasun-ai-runtime-production.sh",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "devnet:sync": "pnpm --filter @nasun/devnet-config sync",
    "check:x-tokens": "./scripts/check-x-tokens.sh"
  },
  "devDependencies": {
    "html-encoding-sniffer": "4.0.0",
    "sharp": "^0.35.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ],
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@mysten/sui": "1.45.2",
      "happy-dom": ">=20.0.0",
      "valibot": ">=1.4.2",
      "esbuild": ">=0.28.1",
      "fast-xml-parser": ">=5.10.1 <6",
      "h3": "^1.15.6",
      "qs": ">=6.15.2",
      "lodash": ">=4.18.0",
      "lodash-es": ">=4.18.0",
      "axios": ">=1.18.0",
      "js-cookie": ">=3.0.7",
      "hono": ">=4.12.34 <5",
      "@hono/node-server": ">=1.19.15 <2",
      "@mysten/ledgerjs-hw-app-sui": "0.7.0",
      "readable-stream": "^3.6.2 || ^4.0.0",
      "rollup": ">=4.59.0 <5",
      "vite": ">=7.3.5 <8",
      "fast-uri": ">=3.1.5 <4",
      "flatted": ">=3.4.2",
      "nanoid": ">=3.3.18 <4",
      "socket.io-parser": ">=4.2.7 <5",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "basic-ftp": ">=5.3.1 <6",
      "depcheck>minimatch": ">=7.4.8 <8",
      "picomatch@<2.3.2": ">=2.3.2 <3",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5",
      "postcss": ">=8.5.23 <9",
      "brace-expansion@>=1 <2": ">=1.1.17 <2",
      "brace-expansion@>=2 <3": ">=2.1.4 <3",
      "brace-expansion@>=4 <6": ">=5.0.9 <6",
      "dompurify": ">=3.4.13 <4",
      "ws": ">=8.20.1",
      "serialize-javascript": ">=7.0.5",
      "form-data": ">=4.0.6 <5",
      "react-router": ">=7.18.2 <8",
      "react-router-dom": ">=7.18.2 <8",
      "undici@>=7 <8": ">=7.29.0 <8",
      "undici@>=6 <7": ">=6.28.0 <7",
      "vitest@>=3 <4": ">=3.2.6 <4",
      "yaml": ">=1.10.3 <2",
      "mermaid": ">=11.16.1 <12",
      "i18next-http-backend": ">=3.0.5 <4",
      "ip-address": ">=10.3.1 <11",
      "@babel/core": ">=7.29.6 <8",
      "js-yaml@>=3 <4": ">=3.15.1 <4",
      "js-yaml@>=4 <5": ">=4.3.1 <5",
      "uuid@>=11 <12": ">=11.1.1 <12"
    }
  }
}
