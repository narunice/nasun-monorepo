# /etc/systemd/system/nasun-ai-host.service
#
# Box-hosted AI host. Replaces the `baram/executor` Lambda that sat behind the
# prod API Gateway, which the 2026-07 AWS exit removed without migrating -- the
# reason every trader cycle had been failing at `infer(hostUrl)` since. Serves
# /infer, /execute-capability, /execute, /record, /result, /info, /health.
#
# Callers are local only: chat-server (:3101) and the per-agent nasun-ai-runtime
# processes, both on this box. The listener binds 127.0.0.1 and nginx does NOT
# route to this port -- do not add a route. API Gateway used to enforce an API
# key in front of the Lambda; HOST_API_KEY keeps that as defence in depth on top
# of the loopback bind.
#
# Unlike the sibling box services, this one does NOT set IPAddressDeny=any:
# /infer calls external LLM providers over HTTPS, so egress must stay open. The
# other hardening directives match the siblings.
#
# Secrets:
#   - LoadCredential puts the executor signing key on a per-service ramfs at
#     $CREDENTIALS_DIRECTORY/executor-key. systemd stages it mode 0440, not
#     0400: the group bit is how this unit's own user reads it, and the ramfs
#     directory is 0700 and reachable by no other service. src/secrets.ts knows
#     that path is systemd-staged and only requires it to not be world-
#     readable there; outside it the strict 0600 rule still applies. Install
#     the key at /etc/nasun/nasun-ai-host/executor.key (root:root 0600); it is
#     the `nasun-ai-executor-prod` keystore entry, i.e. the executor registered
#     on chain. Any of the three keystore export forms works (bech32
#     `suiprivkey1...`, 64 hex chars, base64 of 32 bytes) -- secrets.ts
#     normalizes them. EXECUTOR_EXPECTED_ADDRESS below turns a wrong key into a
#     refusal to start instead of an abort on every settlement.
#   - EnvironmentFile carries the LLM provider API keys. Keep it root:root 0600
#     and out of the repo. At least one of GROQ_API_KEY / CEREBRAS_API_KEY /
#     OPENROUTER_API_KEY / DEEPSEEK_API_KEY / MISTRAL_API_KEY /
#     SAMBANOVA_API_KEY / GEMINI_API_KEY must be set, or startup fails fast.
#
# Deploy: `node build.mjs` then scp dist/server.mjs to /srv/nasun/nasun-ai-host/.
# See docs/box-services-deploy.md. esbuild does not typecheck -- run
# `npx tsc -p tsconfig.json` first.

[Unit]
Description=Nasun AI host (/infer + AER settlement for nasun-ai-runtime agents)
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/nasun/nasun-ai-host
ExecStart=/usr/bin/node /srv/nasun/nasun-ai-host/server.mjs
Restart=on-failure
RestartSec=2

# Writable state for the 7-day result cache (/var/lib/nasun-ai-host).
StateDirectory=nasun-ai-host

LoadCredential=executor-key:/etc/nasun/nasun-ai-host/executor.key
EnvironmentFile=/etc/nasun/nasun-ai-host/provider-keys.env

Environment=HOST_BIND=127.0.0.1
Environment=HOST_PORT=4500
Environment=EXECUTOR_KEY_PATH=%d/executor-key
# The on-chain registered executor. Must equal AGENT_GLOBAL_EXECUTOR_ADDRESS in
# the chat-server .env; the agent's /infer preflight rejects a mismatch with
# `executor_mismatch`, so disagreement here is silent until a cycle runs.
Environment=EXECUTOR_EXPECTED_ADDRESS=0x6f516935f336545fa89365f53e0cbd9f5e02399d08eb309fee6e8e130262ee8f
Environment=RESULT_DB_PATH=/var/lib/nasun-ai-host/results.db

# Local fullnode: the box runs its own, so inference and settlement do not
# depend on the public RPC edge being reachable.
Environment=SUI_RPC_URL=http://127.0.0.1:9000

# On-chain ids, from packages/devnet-config/devnet-ids.json (`baram`). They must
# match the AGENT_GLOBAL_* keys in the chat-server .env, because the agent signs
# against the capability these ids resolve.
Environment=BARAM_PACKAGE_ID=0x61172579f109c1fcdbb379389fb33bffa58bf47711bda4fa38e71938a329f743
Environment=BARAM_REGISTRY_ID=0x492b7dd12a2deb511023a5400c139e9c82941402df853b0b4eefc58f6e10137e
Environment=AER_PACKAGE_ID=0x3fdb58e558e170c85e0770fd71999dd1e8c0d5cfae8483750f922f942b7aee5f
Environment=AER_REGISTRY_ID=0xa5855705c77505ea68d3519dc8808db01ecea26fed888c36500d7bf15d2e62ba

# Intentionally empty: the executor / attestation / compliance / staking /
# budget packages were not deployed in v8 (baram-TEE deferred, see the
# `_deferred_v8` note in devnet-ids.json). sui.ts treats this as a supported
# rollout state -- appendExecutorHeartbeat returns early when the three are
# unset and the AER submission proceeds unchanged. Fill them in only once the
# executor package is actually published, or every settlement PTB will abort
# against a package that does not exist.
Environment=EXECUTOR_PACKAGE_ID=
Environment=EXECUTOR_REGISTRY_ID=
Environment=EXECUTOR_PROCESSED_REQUESTS_ID=

# Atomic-swap PTB path. This was set to true on the first install with a
# comment claiming it matched the runtime's PR1A_SWAP_DISABLED -- an
# assumption, and a wrong one: production agents run with
# AGENT_GLOBAL_PR1A_SWAP_DISABLED=false, so the agent decides BUY and the
# host then refuses it with `preflight: swap_disabled`. Every trade died
# there, visible only in the agent's log.
#
# The allowlists below are what the handler validates each swap against at
# the boundary (validateSwapAtBoundary), so they are the actual safety
# control rather than this flag: a swap may only touch this DeepBook package
# and this pool, and MAX_SLIPPAGE_BPS_CAP bounds the price impact. All three
# ids were read off the chain on 2026-10-07 -- the pool reports itself as
# Pool<NBTC, NUSDC> under this package, and DEEP_TYPE comes from that
# package's own swap_exact_quote_for_base signature.
#
# Set LAMBDA_SWAP_DISABLED=true to re-gate the host without touching the
# agents.
Environment=LAMBDA_SWAP_DISABLED=false
Environment=DEEPBOOK_PACKAGE_ALLOWLIST=0xf0dce6bfc71db3f20be146e65a70cc721dd82d6bc1a1be84febfa58a1018ea00
Environment=DEEPBOOK_POOL_ALLOWLIST=0x1addff570f17f0e12fa14c5f986806ce21bd5cc0542c4548ebf011a56eb26ec9
Environment=DEEP_TYPE=0x642e81bd21a2dea6dd90d41a5f6bc18d6e63c0442f901d12198a894ed3b6a15a::deep::DEEP
Environment=MAX_SLIPPAGE_BPS_CAP=500

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
