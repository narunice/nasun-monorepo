# /etc/systemd/system/nasun-identity-compute.service
# Box-co-located identity COMPUTE service (AWS-exit #4, de-Lambda C0). Clones the
# nasun-identity.service hardening verbatim; differs only in: port 3212, a SELECT-only DB role
# (nasun_compute_ro), and a distinct server-to-server bearer (compute-bearer) presented by the
# API Gateway HTTP-proxy. Localhost-only (PG + the nginx reverse proxy are both loopback), so
# IPAddressDeny=any / IPAddressAllow=localhost applies unchanged.
#
# ★ EGRESS NOTE: C0/C1 make NO external calls (loopback PG only). C3a login (sui/metamask
# prepare+connect-verify) also stays LOOPBACK-ONLY: it calls the sibling issuer (:3210 /mint) and
# nasun-identity (:3211 /profile/upsert) over 127.0.0.1, both covered by IPAddressAllow=localhost -- so
# NO egress relaxation is needed for C3a. Only later slices that reach Twitter / Telegram / Sui RPC will
# need outbound internet -> at that point relax IPAddressAllow (or split the egress-needing handlers
# into a separate egress-allowed unit). Do NOT widen this for C0/C1/C3a.
[Unit]
Description=Nasun identity compute service (de-Lambda handler logic, box PG)
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/nasun/identity-compute
ExecStart=/usr/bin/node /srv/nasun/identity-compute/server.mjs
Restart=on-failure
RestartSec=2

Environment=COMPUTE_PORT=3212
Environment=COMPUTE_BIND=127.0.0.1
Environment=COMPUTE_PG_SCHEMA=public
Environment=COMPUTE_PG_HOST=127.0.0.1
Environment=COMPUTE_PG_DATABASE=nasun_dal
Environment=COMPUTE_PG_USER=nasun_compute_ro
# C3a login CORS: must match the auth-sui/auth-metamask lambdas' ALLOWED_ORIGINS exactly (cdk
# constants/cors.ts ALLOWED_ORIGINS_ENV) so the origin-allowlist + credentials CORS the box returns is
# byte-identical to what the lambdas returned, for every login origin once the API Gateway repoints.
Environment=ALLOWED_ORIGINS=https://nasun.io,https://www.nasun.io,https://staging.nasun.io,https://explorer.nasun.io,https://staging.explorer.nasun.io,https://gensol.io,https://www.gensol.io,https://gensol.nasun.io,https://staging.gensol.io,https://pado.finance,https://staging.pado.finance,https://baram.nasun.io,https://gostop.app,https://www.gostop.app,https://staging.gostop.app,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# Secrets arrive host-decrypted into the per-unit tmpfs ($CREDENTIALS_DIRECTORY), never
# plaintext on disk, owned by this unit's dynamic user only, auto-removed on stop.
LoadCredentialEncrypted=pg-password:/srv/nasun/identity-compute/secrets/pg-password.cred
LoadCredentialEncrypted=compute-bearer:/srv/nasun/identity-compute/secrets/compute-bearer.cred
# C3a login secrets (loopback callers; provision = separate go). UNCOMMENT all three at the C3a cutover.
# Cred names MUST match config.ts exactly (a typo silently keeps login disabled -> /auth/* returns 503):
#   issuer-mint-bearer   = the issuer mint-secret value     (Authorization to :3210 /mint)
#   identity-write-bearer = the nasun-identity bearer value  (Authorization to :3211 /profile/upsert)
#   wallet-proof-secret  = the WALLET_PROOF_SECRET .secret   (HMAC key; MUST be >=32 chars or the unit
#                                                             crash-loops by design once provisioned)
LoadCredentialEncrypted=issuer-mint-bearer:/srv/nasun/identity-compute/secrets/issuer-mint-bearer.cred
LoadCredentialEncrypted=identity-write-bearer:/srv/nasun/identity-compute/secrets/identity-write-bearer.cred
LoadCredentialEncrypted=wallet-proof-secret:/srv/nasun/identity-compute/secrets/wallet-proof-secret.cred

# --- hardening (mirrors nasun-identity.service / nasun-issuer.service) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6
# No internet: serve on loopback + reach Postgres on loopback only (see EGRESS NOTE above).
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target
