{
  "name": "@nasun/explorer-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc && mkdir -p dist/data && (cp src/data/*.json dist/data/ 2>/dev/null || true)",
    "typecheck": "tsc --noEmit",
    "lint:sql": "bash scripts/check-sql-antipatterns.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/lib-dynamodb": "^3.400.0",
    "@hono/node-server": "^1.13.8",
    "@mysten/sui": "^1.21.1",
    "@nasun/standing": "workspace:*",
    "bs58": "^6.0.0",
    "busboy": "^1.6.0",
    "hono": "^4.7.5",
    "jose": "^5.2.0",
    "postgres": "^3.4.5",
    "sharp": "^0.35.0",
    "tweetnacl": "^1.0.3",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.16.0",
    "typescript": "~5.9.3"
  }
}
